{
  "name": "@omni-work/terminal-core",
  "version": "0.1.1",
  "description": "Terminal sizing and input utilities shared by OmniWork clients.",
  "keywords": [
    "omniwork",
    "terminal",
    "tmux",
    "typescript"
  ],
  "author": "zhangbozhb <zhangbozhb@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhangbozhb/OmniWork.git",
    "directory": "packages/terminal-core"
  },
  "homepage": "https://github.com/zhangbozhb/OmniWork/tree/main/packages/terminal-core#readme",
  "bugs": {
    "url": "https://github.com/zhangbozhb/OmniWork/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build:deps": "pnpm --filter '@omni-work/terminal-core^...' build:dist",
    "build:dist": "tsc -p tsconfig.build.json",
    "build": "pnpm run build:deps && pnpm run build:dist",
    "typecheck": "pnpm run build:deps && tsc -p tsconfig.json",
    "lint": "pnpm run build:deps && tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build:deps && node --experimental-strip-types src/index.ts"
  },
  "dependencies": {
    "@omni-work/protocol-ts": "0.1.1"
  },
  "devDependencies": {
    "typescript": "^5.8.0"
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
