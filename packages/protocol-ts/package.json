{
  "name": "@omni-work/protocol-ts",
  "version": "0.1.1",
  "description": "Shared protocol types, schemas, and pairing utilities for OmniWork.",
  "keywords": [
    "omniwork",
    "protocol",
    "typescript",
    "zod"
  ],
  "author": "zhangbozhb <zhangbozhb@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhangbozhb/OmniWork.git",
    "directory": "packages/protocol-ts"
  },
  "homepage": "https://github.com/zhangbozhb/OmniWork/tree/main/packages/protocol-ts#readme",
  "bugs": {
    "url": "https://github.com/zhangbozhb/OmniWork/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build:dist": "tsc -p tsconfig.build.json",
    "build": "pnpm run build:dist",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts"
  },
  "dependencies": {
    "@noble/ciphers": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "typescript": "^5.8.0"
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
