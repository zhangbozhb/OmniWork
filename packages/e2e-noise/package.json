{
  "name": "@omni-work/e2e-noise",
  "version": "0.1.1",
  "description": "Noise-based end-to-end encryption primitives for OmniWork transports.",
  "keywords": [
    "omniwork",
    "noise-protocol",
    "encryption",
    "websocket"
  ],
  "author": "zhangbozhb <zhangbozhb@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhangbozhb/OmniWork.git",
    "directory": "packages/e2e-noise"
  },
  "homepage": "https://github.com/zhangbozhb/OmniWork/tree/main/packages/e2e-noise#readme",
  "bugs": {
    "url": "https://github.com/zhangbozhb/OmniWork/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build:deps": "pnpm --filter '@omni-work/e2e-noise^...' build:dist",
    "build:dist": "tsc -p tsconfig.build.json",
    "build": "pnpm run build:deps && pnpm run build:dist",
    "typecheck": "pnpm run build:deps && tsc -p tsconfig.json",
    "lint": "pnpm run build:deps && tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build:deps && node --experimental-strip-types --test tests/*.test.ts"
  },
  "dependencies": {
    "@noble/ciphers": "^2.2.0",
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "@omni-work/protocol-ts": "0.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "typescript": "^5.8.0"
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public"
  }
}