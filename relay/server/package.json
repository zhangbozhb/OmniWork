{
  "name": "@omni-work/relay-server",
  "version": "0.1.0",
  "type": "module",
  "main": "src/main.ts",
  "scripts": {
    "dev": "OMNIWORK_RELAY_ADMIN_WEB_ENABLED=true node --experimental-strip-types src/main.ts",
    "start": "node --experimental-strip-types src/main.ts",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts tests/upgrade/*.test.ts && node --experimental-strip-types src/main.ts --check"
  },
  "dependencies": {
    "@omni-work/protocol-ts": "0.1.0",
    "geoip-lite": "^2.0.3",
    "js-yaml": "^5.2.1"
  },
  "devDependencies": {
    "@types/geoip-lite": "^1.4.4",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.19.19",
    "typescript": "^5.8.0"
  },
  "files": [
    "admin-web/",
    "config.example.yml",
    "src/",
    "README.md"
  ],
  "engines": {
    "node": ">=22.6.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
