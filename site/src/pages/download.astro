---
import { readFileSync } from "node:fs";
import BaseLayout from "@/layouts/BaseLayout.astro";

type DownloadLink = {
  label: string;
  url: string;
  type: string;
  sha256?: string | null;
  note?: string;
};

type DownloadsManifest = {
  version: string;
  releasedAt: string;
  releaseUrl: string;
  allReleasesUrl: string;
  checksumsUrl?: string;
  assets: {
    ios: {
      appStore?: DownloadLink;
      ipa?: DownloadLink;
    };
    android: {
      apk?: DownloadLink;
    };
    desktopAgent: {
      archive?: DownloadLink;
      npm?: DownloadLink;
    };
    relayServer?: {
      npm?: DownloadLink;
    };
    web: {
      app: DownloadLink;
    };
  };
};

const isDownloadLink = (link: DownloadLink | undefined): link is DownloadLink => Boolean(link);

const downloads = JSON.parse(
  readFileSync(new URL("../../public/downloads.json", import.meta.url), "utf8"),
) as DownloadsManifest;

const groups = [
  {
    id: "ios",
    title: "iOS",
    description: "当前仓库支持从源码构建签名 App，但尚无可由仓库验证的 App Store 或公开 IPA 下载。",
    links: [downloads.assets.ios.appStore, downloads.assets.ios.ipa].filter(isDownloadLink),
    empty: "请按安装文档配置 Apple 签名后从源码构建。",
  },
  {
    id: "android",
    title: "Android",
    description: "当前仓库支持从源码构建 APK/AAB，但清单中尚无带 SHA256 的公开 APK。",
    links: [downloads.assets.android.apk].filter(isDownloadLink),
    empty: "请按安装文档从源码构建；不要使用未经校验的安装包。",
  },
  {
    id: "desktop-agent",
    title: "Desktop Agent",
    description: "已通过 npm 发布。要求 Node.js 22.6 或更高版本，并需要本机 tmux。",
    links: [downloads.assets.desktopAgent.npm, downloads.assets.desktopAgent.archive].filter(isDownloadLink),
    empty: "",
  },
  {
    id: "relay-server",
    title: "Relay Server",
    description: "自托管 Relay 已通过 npm 发布，支持配置检查、E2E 转发、P2P 升级和可选邮件登录。",
    links: [downloads.assets.relayServer?.npm].filter(isDownloadLink),
    empty: "",
  },
  {
    id: "web",
    title: "Web App",
    description: "浏览器客户端由现有的 Web SPA 承载，访问入口固定为 /app/。",
    links: [downloads.assets.web.app],
    empty: "",
  },
];
---

<BaseLayout title="下载" description="Download OmniWork for iOS, Android, Desktop Agent, and Web.">
  <section class="section">
    <div class="container">
      <p class="eyebrow">Download</p>
      <h1 class="section-title">选择适合您的平台入口。</h1>
      <p class="section-lede">
        当前仓库版本为 {downloads.version}，发布日期为 {downloads.releasedAt}。npm 包是当前已验证的公开交付渠道；
        移动端只展示清单中真实存在且经过校验的安装入口。
      </p>
      <div class="button-row">
        <a class="button primary" href="https://www.npmjs.com/org/omni-work">查看 npm 包</a>
        <a class="button" href={downloads.allReleasesUrl}>GitHub Releases</a>
        <a class="button" href="https://github.com/zhangbozhb/OmniWork/blob/main/docs/app-installation.md">源码构建说明</a>
        {downloads.checksumsUrl && <a class="button" href={downloads.checksumsUrl}>校验文件</a>}
      </div>
    </div>
  </section>

  <section class="section download-section">
    <div class="container download-grid">
      {groups.map((group) => (
        <article class="card download-card" id={group.id}>
          <span class="pill">{group.title}</span>
          <h2>{group.title}</h2>
          <p>{group.description}</p>
          {!group.links.length && <p class="unavailable">{group.empty}</p>}
          <div class="download-links">
            {group.links.map((link) => (
              <div class="download-link">
                <a class="button primary" href={link.url}>{link.label}</a>
                {link.sha256 && <code>SHA256: {link.sha256}</code>}
                {link.note && <small>{link.note}</small>}
              </div>
            ))}
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .download-section {
    padding-top: 0;
  }

  .download-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
  }

  .download-card {
    min-height: 300px;
  }

  .download-card h2 {
    margin: 0 0 12px;
    font-size: 28px;
    letter-spacing: -0.03em;
  }

  .download-card p {
    margin-bottom: 22px;
  }

  .download-links {
    display: grid;
    gap: 14px;
  }

  .download-link {
    display: grid;
    gap: 8px;
    justify-items: start;
    padding-top: 14px;
    border-top: 1px solid var(--line);
  }

  .download-link code {
    max-width: 100%;
    overflow-wrap: anywhere;
    color: var(--muted);
    font-size: 12px;
  }

  .download-link small {
    color: var(--danger);
    line-height: 1.6;
  }

  .unavailable {
    color: var(--danger);
  }

  @media (max-width: 820px) {
    .download-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
