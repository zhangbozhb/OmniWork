---
import { readFileSync } from "node:fs";
import BaseLayout from "@/layouts/BaseLayout.astro";

const downloads = JSON.parse(
  readFileSync(new URL("../../public/downloads.json", import.meta.url), "utf8"),
) as {
  version: string;
  releasedAt: string;
  releaseUrl: string;
  allReleasesUrl: string;
};
---

<BaseLayout title="发布记录" description="OmniWork public changelog and release links.">
  <section class="section">
    <div class="container">
      <p class="eyebrow">Changelog</p>
      <h1 class="section-title">版本记录与公开交付。</h1>
      <p class="section-lede">
        本页展示仓库版本摘要。npm 包版本以 npm 为准，真实安装资产与完整发布说明以 GitHub Releases 为准。
      </p>
    </div>
  </section>

  <section class="section changelog-section">
    <div class="container">
      <article class="card release-card">
        <span class="pill">Unreleased</span>
        <h2>Next</h2>
        <ul>
          <li>协议 v2 改用长期 Ed25519 身份、双层授权与签名 X25519 E2E 会话。</li>
          <li>设备目标链接只包含 Relay URL、Agent Device ID 与可选名称。</li>
          <li>Relay 新增 App 登录令牌；Relay 与 Agent Admin 新增审批和中英文界面。</li>
          <li>App 升级到 React Native 0.87.1，并在保留旧数据库路径的前提下迁移 Native Inbox SQLite 驱动。</li>
          <li>Relay/P2P 传输在关闭或替换连接后忽略迟到的异步协商结果。</li>
        </ul>
      </article>

      <article class="card release-card">
        <span class="pill">Current</span>
        <h2>{downloads.version}</h2>
        <p>发布时间：{downloads.releasedAt}</p>
        <ul>
          <li>修复 npm 运行时包编译与声明文件发布。</li>
          <li>确保 Desktop Agent 与 Relay Server 可在全局 npm 安装后运行。</li>
          <li>补齐包级 README、npm metadata、仓库链接和 MIT License。</li>
          <li>发布前在干净临时目录安装 tarball 并验证 CLI 与共享库。</li>
        </ul>
        <div class="button-row">
          <a class="button primary" href="https://www.npmjs.com/org/omni-work">npm Packages</a>
          <a class="button" href={downloads.allReleasesUrl}>全部 Releases</a>
        </div>
      </article>
    </div>
  </section>
</BaseLayout>

<style>
  .changelog-section {
    padding-top: 0;
  }

  .release-card {
    max-width: 760px;
  }

  .release-card + .release-card {
    margin-top: 20px;
  }

  .release-card h2 {
    margin: 0 0 12px;
    font-size: 36px;
    letter-spacing: -0.04em;
  }
</style>
