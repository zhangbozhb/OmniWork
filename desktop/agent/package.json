{
  "name": "@omni-work/desktop-agent",
  "version": "0.1.1",
  "description": "Desktop agent for managing terminal-based coding sessions with OmniWork.",
  "keywords": [
    "omniwork",
    "coding-agent",
    "terminal",
    "tmux",
    "cli"
  ],
  "author": "zhangbozhb <zhangbozhb@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhangbozhb/OmniWork.git",
    "directory": "desktop/agent"
  },
  "homepage": "https://github.com/zhangbozhb/OmniWork/tree/main/desktop/agent#readme",
  "bugs": {
    "url": "https://github.com/zhangbozhb/OmniWork/issues"
  },
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build:deps": "pnpm --filter @omni-work/protocol-ts build && pnpm --filter @omni-work/relay-client build && pnpm --filter @omni-work/terminal-core build && pnpm --filter @omni-work/e2e-noise build",
    "build": "pnpm run build:deps && tsc -p tsconfig.build.json",
    "dev": "pnpm run build:deps && node --experimental-strip-types src/main.ts",
    "typecheck": "pnpm run build:deps && tsc -p tsconfig.json",
    "lint": "pnpm run build:deps && tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build:deps && node --experimental-strip-types --test tests/*.test.ts tests/transport/*.test.ts"
  },
  "dependencies": {
    "@omni-work/e2e-noise": "0.1.1",
    "@omni-work/surface-hook-post": "0.1.1",
    "@omni-work/surface-hook-record": "0.1.1",
    "@omni-work/protocol-ts": "0.1.1",
    "@omni-work/relay-client": "0.1.1",
    "@omni-work/terminal-core": "0.1.1",
    "@openai/codex-sdk": "0.142.5",
    "@roamhq/wrtc": "^0.8.0",
    "js-yaml": "^5.2.1",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.19.19",
    "typescript": "^5.8.0"
  },
  "bin": {
    "omniwork-agent": "bin/omniwork-agent.mjs"
  },
  "files": [
    "bin/",
    "config.example.yml",
    "dist/",
    "static/",
    "README.md"
  ],
  "engines": {
    "node": ">=22.6.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
