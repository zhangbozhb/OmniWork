{
  "name": "@omni-work/desktop-agent",
  "version": "0.1.0",
  "type": "module",
  "main": "src/main.ts",
  "scripts": {
    "dev": "node --experimental-strip-types src/main.ts",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts tests/transport/*.test.ts"
  },
  "dependencies": {
    "@omni-work/e2e-noise": "0.1.0",
    "@omni-work/surface-hook-post": "0.1.0",
    "@omni-work/surface-hook-record": "0.1.0",
    "@omni-work/protocol-ts": "0.1.0",
    "@omni-work/relay-client": "0.1.0",
    "@omni-work/terminal-core": "0.1.0",
    "@openai/codex-sdk": "0.142.5",
    "@roamhq/wrtc": "^0.8.0",
    "js-yaml": "^5.2.1",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.19.19",
    "typescript": "^5.8.0"
  },
  "bin": {
    "omniwork-agent": "bin/omniwork-agent.mjs"
  },
  "files": [
    "bin/",
    "config.example.yml",
    "src/",
    "static/",
    "README.md"
  ],
  "engines": {
    "node": ">=22.6.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
